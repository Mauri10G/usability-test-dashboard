# Copia este archivo como .env y pon tu clave de Google AI Studio.
# Sin clave, POST /ia/analizar usa las reglas por palabras clave y
# POST /ia/evaluar-captura responde que necesita la clave.
GEMINI_API_KEY=

# Opcional: modelos a probar en orden, separados por coma. Si uno falla,
# tarda demasiado o esta saturado, se pasa al siguiente.
# GEMINI_MODELOS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3.8-flash
# Para la evaluacion de capturas (prioriza calidad sobre velocidad):
# GEMINI_MODELOS_CAPTURA=gemini-3-flash-preview,gemini-3.8-flash,gemini-3.1-flash-lite-preview,gemini-flash-lite-latest
# Para el prototipo corregido (modelos con salida de imagen). Con el plan
# gratuito responden 429 y se usa el boceto automatico.
# GEMINI_MODELOS_IMAGEN=gemini-3.1-flash-image,gemini-2.5-flash-image
